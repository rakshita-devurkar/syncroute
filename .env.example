# Copy to .env and fill in. .env is gitignored and must never be committed.
# Create a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Pinned model version. Use an explicit version for recorded experiments so a
# silent alias bump cannot change a frozen result. Aliases: jev-latest, jev-preview.
TYPESAFE_MODEL=jev-1.13.0

# Optional overrides
TYPESAFE_BASE_URL=https://api.typesafe.ai
SYNCROUTE_DB_PATH=syncroute.db

# Used only to label cost estimates. Never used to invent usage numbers.
TYPESAFE_INPUT_PRICE_PER_MTOK=0.042
TYPESAFE_PRICE_AS_OF=2026-09-21
